{
  "name": "geulmoa",
  "version": "0.1.0",
  "private": true,
  "description": "화면에서 쓰는 손글씨로 한글 TTF를 만드는 실험용 사이트",
  "scripts": {
    "build": "esbuild site/worker.src.js --bundle --minify --platform=browser --format=iife --outfile=site/worker.js && esbuild site/engine-main.src.js --bundle --minify --platform=browser --format=iife --outfile=site/engine-main.js",
    "start": "node serve.js",
    "test": "node tests/context.test.js && node tests/capture.test.js && node tests/engine.test.js && node tests/coloring.test.js && node tests/vector-strokes.test.js && node tests/vector-correction-settings.test.js && node tests/designer.test.js && node tests/svg-dedupe.test.js",
    "test:browser": "node tests/browser-coloring.test.js",
    "test:vector": "node tests/browser-vector.test.js",
    "test:auto-vector": "node tests/browser-auto-vector.test.js",
    "test:auto-vector:full": "node tests/browser-auto-vector-full.test.js",
    "test:designer": "node tests/browser-designer.test.js",
    "test:compat": "node tests/browser-compatibility.test.js",
    "test:compat:full": "node tests/browser-compatibility-full.test.js",
    "test:mobile": "node tests/browser-mobile-flow.test.js",
    "test:modal": "node tests/browser-modal.test.js"
  },
  "dependencies": {
    "imagetracerjs": "1.2.6",
    "svg2ttf": "6.1.0",
    "svgpath": "2.6.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "playwright": "1.65.1"
  }
}
